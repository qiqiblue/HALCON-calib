[settings]
os=Linux
os.distro=ubuntu22
arch=armv8
compiler=clang
compiler.version=14
compiler.libcxx=libstdc++11
compiler.cppstd=17
build_type=MinSizeRel

[conf]
tools.build:compiler_executables={"c": "/usr/bin/clang", "cpp": "/usr/bin/clang++"}
tools.build:cxxflags=["-march=armv8-a+crypto"]
tools.cmake.cmaketoolchain:generator=Ninja
tools.system.package_manager:mode=install

[tool_requires]
!(cmake/*|ninja/*|pkgconf/*|meson/*): cmake/4.4.0
!(cmake/*|ninja/*|pkgconf/*|meson/*): ninja/1.13.2
!(cmake/*|ninja/*|pkgconf/*|meson/*): pkgconf/2.5.1
!(cmake/*|ninja/*|pkgconf/*|meson/*): meson/1.10.2

[replace_tool_requires]
cmake/*: cmake/4.4.0
ninja/*: ninja/1.13.2
pkgconf/*: pkgconf/2.5.1
meson/*: meson/1.10.2
